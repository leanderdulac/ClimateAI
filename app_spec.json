{
  "name": "climatewise",
  "services": [
    {
      "name": "backend",
      "github": {
        "repo": "leanderdulac/ClimateWise",
        "branch": "main",
        "deploy_on_push": true
      },
      "dockerfile_path": "server/Dockerfile",
      "source_dir": ".",
      "envs": [
        {
          "key": "PYTHONUNBUFFERED",
          "value": "1",
          "scope": "RUN_AND_BUILD_TIME"
        },
        {
          "key": "ENVIRONMENT",
          "value": "production",
          "scope": "RUN_AND_BUILD_TIME"
        },
        {
          "key": "API_PREFIX",
          "value": "/v1",
          "scope": "RUN_AND_BUILD_TIME"
        }
      ],
      "instance_size_slug": "professional-xs",
      "instance_count": 1,
      "http_port": 8000,
      "health_check": {
        "http_path": "/health"
      }
    }
  ],
  "static_sites": [
    {
      "name": "frontend",
      "github": {
        "repo": "leanderdulac/ClimateWise",
        "branch": "main",
        "deploy_on_push": true
      },
      "build_command": "npm install && npm run build",
      "source_dir": "client",
      "output_dir": "dist",
      "envs": [
        {
          "key": "VITE_API_BASE_URL",
          "value": "${backend.PRIVATE_URL}",
          "scope": "BUILD_TIME"
        }
      ],
      "catchall_document": "index.html"
    }
  ],
  "region": "nyc",
  "ingress": {
    "rules": [
      {
        "match": {
          "path": {
            "prefix": "/api"
          }
        },
        "component": {
          "name": "backend"
        }
      },
      {
        "match": {
          "path": {
            "prefix": "/"
          }
        },
        "component": {
          "name": "frontend"
        }
      }
    ]
  }
}