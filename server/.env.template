# Configurações do servidor
HOST=0.0.0.0
PORT=8000
DEBUG=true
ENVIRONMENT=development

# 🔐 CHAVE SECRETA OBRIGATÓRIA (32+ caracteres)
# Gere uma chave segura: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=sua_chave_secreta_muito_segura_aqui_com_pelo_menos_32_caracteres

# CORS - Origens permitidas (separadas por vírgula)
ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Chaves de API
METEOBLUE_API_KEY=sua_chave_meteoblue_aqui
OPENWEATHER_API_KEY=sua_chave_openweather_aqui
OPEN_METEO_API_KEY=
WEATHERNEXT_ENABLED=true
WEATHERNEXT_CACHE_TTL=7200
WEATHERNEXT_AUTO_REFRESH=false

# Optional remote inference (Akash / DePIN). Leave unset for local compute.
# Never returned by /api/v1/compute/status.
INFERENCE_SERVICE_URL=
INFERENCE_SERVICE_TOKEN=

# Configurações de banco de dados
DATABASE_URL=sqlite+aiosqlite:///./climatewise-dev.db

# Configurações de cache
REDIS_URL=redis://localhost:6379

# Configurações de modelos
MODEL_PATH=./models
