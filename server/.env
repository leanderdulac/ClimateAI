# Configurações do ambiente para ClimateAI

# Configurações básicas
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=your-super-secret-and-long-key-here-make-it-random-and-at-least-32-characters-long
HOST=0.0.0.0
PORT=8000

# Banco de dados
DATABASE_URL=postgresql+asyncpg://climateai:climateai123@localhost/climateai
DB_PASSWORD=climateai123

# Configurações da API Embrapa (substitua pelas chaves reais)
EMBRAPA_API_KEY=your_api_key_here
EMBRAPA_API_URL=https://api.cnptia.embrapa.br
EMBRAPA_API_VERSION=climapi/v1

# Configurações OpenMeteo
OPENMETEO_API_KEY=

# Google Gemini API Key
GEMINI_API_KEY=AIzaSyB7mgES13tpKVXWFoCUYvmWQATv6JeUHlU

# Configurações da API OpenWeatherMap (opcional)
OPENWEATHER_API_KEY=

# Configurações Alpha Vantage (para preços de commodities - opcional)
ALPHA_VANTAGE_API_KEY=

# Configurações FRED (Federal Reserve Economic Data - opcional)
FRED_API_KEY=

# Configurações Redis (opcional, para cache)
REDIS_URL=redis://localhost:6379

# Configurações de e-mail (opcional)
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USERNAME=
EMAIL_PASSWORD=

# Outras configurações
MAX_FILE_SIZE=10485760  # 10MB
ALLOWED_FILE_EXTENSIONS=csv,json,xlsx,pdf
LOG_LEVEL=INFO
SENTRY_DSN=