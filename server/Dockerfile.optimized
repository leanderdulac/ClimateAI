# Use multi-stage build to optimize image size
# Base stage with common dependencies
FROM python:3.11-slim as base

WORKDIR /app

# Install system dependencies needed for the application
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    postgresql-client \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Create non-root user
RUN useradd --create-home --shell /bin/bash appuser

# Copy requirements first to leverage Docker cache
COPY requirements-prod-ml.txt .

# Install Python dependencies with optimizations
RUN pip install --upgrade pip && \
    pip install --no-cache-dir --timeout 1800 --retries 5 --prefer-binary "numpy<2.0.0" && \
    pip install --no-cache-dir --timeout 1800 --retries 5 --prefer-binary --index-url https://download.pytorch.org/whl/cpu 'torch==2.8.0+cpu' --find-links https://download.pytorch.org/whl/torch_stable.html --no-build-isolation --force-reinstall && \
    pip install --no-cache-dir --timeout 1800 --retries 5 --no-build-isolation -r requirements-prod-ml.txt

# ===== PRODUCTION STAGE =====
FROM base as production

# Copy application code
COPY --chown=appuser:appuser . .

# Change ownership to appuser
RUN chown -R appuser:appuser /app

# Switch to non-root user
USER appuser

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Command to run the application
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4"]

# ===== DEVELOPMENT STAGE =====
FROM base as development

# Install development dependencies
COPY requirements-base.txt requirements-test.txt ./
RUN pip install --no-cache-dir -r requirements-base.txt -r requirements-test.txt

# Copy application code
COPY --chown=appuser:appuser . .

# Expose port
EXPOSE 8000

# Command to run the application in development mode
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--reload", "--log-level", "info"]

# ===== BUILD INFO =====
LABEL version="1.0.0"
LABEL maintainer="ClimateWise"
LABEL description="ClimateWise - Framework Integrado de Modelagem Climático-Econômica (Optimized Image)"
