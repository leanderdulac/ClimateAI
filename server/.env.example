# Production Environment Variables Template
# Copy this to .env and update with production values

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False
API_HOST=yourdomain.com
API_PORT=443

# Security
SECRET_KEY=your-very-secure-secret-key-here-32-chars-minimum
ALLOW_ORIGINS=["https://yourdomain.com", "https://www.yourdomain.com"]

# Database
DATABASE_URL=postgresql://climateai_user:your-secure-password@localhost/climateai

# Redis
REDIS_URL=redis://localhost:6379

# Configurações da API da Embrapa
EMBRAPA_API_KEY=chave_api_aqui
EMBRAPA_API_URL=https://api.cnptia.embrapa.br/agritec
EMBRAPA_API_VERSION=v1

# Configurações do OpenMeteo
OPENMETEO_API_URL=https://api.open-meteo.com
OPENMETEO_CACHE_DIR=.cache
OPENMETEO_CACHE_TIMEOUT=3600  # 1 hora em segundos

# Configurações do serviço de geocodificação
GEOCODING_CACHE_TIMEOUT=86400  # 24 horas em segundos
GEOCODING_MAX_RETRIES=3

# Logging
LOG_LEVEL=INFO