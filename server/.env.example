# ClimateAI Environment Variables
# Copie este arquivo para .env e configure os valores para seu ambiente

# ===== SERVIDOR =====
HOST=localhost
PORT=8000
DEBUG=false

# ===== SEGURANÇA (⚠️ OBRIGATÓRIO EM PRODUÇÃO) =====
# Gerar com: python -c 'import secrets; print(secrets.token_urlsafe(32))'
SECRET_KEY=your-secret-key-here-min-32-chars

# CORS - URLs permitidas separadas por vírgula
ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173

# ===== BANCO DE DADOS =====
DATABASE_ENABLED=true
DATABASE_URL=postgresql+asyncpg://climateai:climateai123@localhost/climateai

# Credenciais do PostgreSQL (usadas apenas em setup)
POSTGRES_USER=climateai
POSTGRES_PASSWORD=climateai123
POSTGRES_DB=climateai

# ===== CACHE (Redis) =====
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# ===== APIs EXTERNAS =====
EMBRAPA_API_KEY=your-embrapa-key
EMBRAPA_API_URL=https://api.embrapa.gov.br
EMBRAPA_API_VERSION=v1

OPENMETEO_API_KEY=optional

# ===== CACHE DE DADOS =====
OPENMETEO_CACHE_DIR=.cache
OPENMETEO_CACHE_TIMEOUT=3600

# ===== GEOCODIFICAÇÃO =====
GEOCODING_CACHE_TIMEOUT=86400
GEOCODING_MAX_RETRIES=3

# ===== MONITORAMENTO =====
PROMETHEUS_METRICS_ENABLED=false
GRAFANA_ADMIN_PASSWORD=admin

# ===== PRODUÇÃO =====
DOMAIN=example.com
DB_PASSWORD=your-secure-password

# ===== DESENVOLVIMIENTO =====
API_HOST=localhost
API_PORT=8000