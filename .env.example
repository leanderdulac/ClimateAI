# ============================================
# ClimateAI Environment Variables Configuration
# ============================================
# INSTRUÇÕES:
# 1. Copie este arquivo para .env: cp .env.example .env
# 2. Gere uma SECRET_KEY segura: ./scripts/generate_secret_key.sh
# 3. Preencha todas as variáveis obrigatórias
# 4. NUNCA commit este arquivo .env no Git!
# ============================================

# ============================================
# DATABASE CONFIGURATION
# ============================================
# PostgreSQL connection string (format: postgresql+asyncpg://user:pass@host:port/dbname)
DATABASE_URL=postgresql+asyncpg://postgres:your_secure_password@localhost:5432/climateai

# Database credentials (alternative method)
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=climateai

# Enable/disable database
DATABASE_ENABLED=true

# ============================================
# SECURITY CONFIGURATION (CRITICAL!)
# ============================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# MUST be at least 32 characters!
SECRET_KEY=

# JWT token expiration
JWT_EXPIRATION_HOURS=24
REFRESH_TOKEN_EXPIRATION_DAYS=7

# ============================================
# SERVER CONFIGURATION
# ============================================
HOST=0.0.0.0
PORT=8000
DEBUG=false
ENVIRONMENT=production

# ============================================
# CORS CONFIGURATION
# ============================================
# Comma-separated list of allowed origins
# Production: Set to your actual domain
ALLOW_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Development (uncomment for local dev):
# ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# ============================================
# EXTERNAL API KEYS
# ============================================
# Embrapa Climate API (https://www.embrapa.br/)
EMBRAPA_API_KEY=
EMBRAPA_API_URL=https://api.cnptia.embrapa.br
EMBRAPA_API_VERSION=climapi/v1

# NOAA Climate API (https://www.ncdc.noaa.gov/cdo-web/)
NOAA_API_KEY=

# Google Gemini AI (https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=

# xAI Grok API (https://x.ai/)
GROK_API_KEY=

# OpenMeteo (free, no key required)
# OPENMETEO_API_KEY=

# ============================================
# CACHE CONFIGURATION
# ============================================
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379

# ============================================
# MONITORING & LOGGING
# ============================================
LOG_LEVEL=INFO
SENTRY_DSN=
PROMETHEUS_METRICS_ENABLED=true

# Grafana admin password
GRAFANA_ADMIN_PASSWORD=admin

# ============================================
# OPENTELEMETRY CONFIGURATION (NEW!)
# ============================================
# Enable OpenTelemetry tracing
OTEL_ENABLED=true

# OTLP Exporter endpoint (OpenTelemetry Collector)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Service identification
OTEL_SERVICE_NAME=climateai-backend
OTEL_SERVICE_VERSION=1.0.0

# Environment (production, staging, development)
ENVIRONMENT=production

# ============================================
# BLOCKCHAIN CONFIGURATION (Optional)
# ============================================
BLOCKCHAIN_ENABLED=false
BC_NODE_URL=
ADMIN_WALLET_ADDRESS=
MIN_BALANCE_THRESHOLD_ETHER=0.05

# ============================================
# FILE UPLOAD CONFIGURATION
# ============================================
MAX_FILE_SIZE=10485760
ALLOWED_FILE_EXTENSIONS=csv,json,xlsx,pdf

# ============================================
# DOMAIN CONFIGURATION (Production)
# ============================================
DOMAIN=yourdomain.com
