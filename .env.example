# ClimateAI - Environment Variables Template
# Copy this file to .env and configure your values

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# ==========================================
# APPLICATION SETTINGS
# ==========================================
SECRET_KEY=CHANGE_THIS_TO_A_STRONG_RANDOM_KEY
DEBUG=False
DOMAIN=your-domain.com

# ==========================================
# EXTERNAL API KEYS
# ==========================================
# Open-Meteo API (free, no key required for basic usage)
OPENMETEO_API_KEY=

# Embrapa API (if you have one)
EMBRAPA_API_KEY=

# ==========================================
# EMAIL CONFIGURATION (optional)
# ==========================================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# ==========================================
# MONITORING & LOGGING
# ==========================================
LOG_LEVEL=INFO
SENTRY_DSN=  # Optional: for error tracking

# ==========================================
# SECURITY SETTINGS
# ==========================================
# CORS settings
ALLOW_ORIGINS=["https://your-domain.com", "https://www.your-domain.com"]

# JWT settings
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==========================================
# PERFORMANCE SETTINGS
# ==========================================
# Worker settings
MAX_WORKERS=4
WORKER_TIMEOUT=300

# Cache settings
CACHE_TTL=3600
REDIS_MAX_CONNECTIONS=20

# ==========================================
# BACKUP SETTINGS
# ==========================================
BACKUP_RETENTION_DAYS=7
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM

# ==========================================
# MONITORING SETTINGS
# ==========================================
PROMETHEUS_METRICS_ENABLED=True
GRAFANA_ADMIN_PASSWORD=CHANGE_THIS_ADMIN_PASSWORD