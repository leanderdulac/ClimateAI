# ClimateAI - Environment Variables Template
# Copy this file to .env and fill in the values for your environment.
# This single file configures both the frontend and the backend.

# ==========================================
# CORE BACKEND SETTINGS
# ==========================================
# Server bind host and port
HOST=0.0.0.0
PORT=8000

# Set to true for development mode (enables debug endpoints, verbose logging)
DEBUG=false

# A 32+ character random string. Generate with:
# python -c 'import secrets; print(secrets.token_urlsafe(32))'
SECRET_KEY=

# Comma-separated list of allowed origins for CORS.
# Example: "http://localhost:5173,http://127.0.0.1:5173,https://your-frontend-domain.com"
ALLOW_ORIGINS=http://localhost:5173

# ==========================================
# SUPABASE (Cloud Database & Auth)
# ==========================================
SUPABASE_URL=https://tyzmywhvpmdfepxdtyes.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ==========================================
# DATABASE (PostgreSQL - Alternative to Supabase)
# ==========================================
DATABASE_ENABLED=false
# Full database connection string (only needed if not using Supabase)
DATABASE_URL=postgresql+asyncpg://climateai:climateai123@localhost:5432/climateai

# ==========================================
# CACHE (Redis)
# ==========================================
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379

# ==========================================
# EXTERNAL API KEYS
# ==========================================
# Required for agricultural zoning and historical data
EMBRAPA_API_KEY=

# Optional, for extended forecast capabilities
OPENMETEO_API_KEY=

# ==========================================
# FRONTEND-SPECIFIC SETTINGS (prefixed with VITE_)
# ==========================================
# The URL of the backend API for the frontend to connect to
VITE_API_URL=http://localhost:8000

# Supabase for frontend (same as backend)
VITE_SUPABASE_URL=https://tyzmywhvpmdfepxdtyes.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here
