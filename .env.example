# ============================================
# ClimateAI Environment Variables Configuration
# ============================================
# INSTRUÇÕES:
# 1. Copie este arquivo para .env: cp .env.example .env
# 2. Gere uma SECRET_KEY segura: ./scripts/generate_secret_key.sh
# 3. Preencha todas as variáveis obrigatórias
# 4. NUNCA commit este arquivo .env no Git!
# ============================================

# ============================================
# DATABASE CONFIGURATION
# ============================================
# PostgreSQL connection string (format: postgresql+asyncpg://user:pass@host:port/dbname)
DATABASE_URL=postgresql+asyncpg://postgres:your_secure_password@localhost:5432/climateai

# Database credentials (alternative method)
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=climateai

# Enable/disable database
DATABASE_ENABLED=true

# ============================================
# SUPABASE CONFIGURATION
# ============================================
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_HOST=aws-1-sa-east-1.pooler.supabase.com
SUPABASE_DB_USER=postgres.your-project-id
SUPABASE_DB_PASSWORD=your-db-password
SUPABASE_DB_NAME=postgres
SUPABASE_DB_PORT=6543

# ============================================
# SECURITY CONFIGURATION (CRITICAL!)
# ============================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# MUST be at least 32 characters!
SECRET_KEY=

# JWT token expiration
JWT_EXPIRATION_HOURS=24
REFRESH_TOKEN_EXPIRATION_DAYS=7

# ============================================
# SERVER CONFIGURATION
# ============================================
HOST=0.0.0.0
PORT=8000
DEBUG=false
ENVIRONMENT=production

# ============================================
# CORS CONFIGURATION
# ============================================
# Comma-separated list of allowed origins
# Production: Set to your actual domain
ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================
# ATLAS DIGITAL DE DESASTRES CONFIGURATION
# ============================================
# URL oficial do Atlas Digital de Desastres Naturais (MDR)
ATLAS_DATA_URL=https://arquivos.atlasdigital.mdr.gov.br/dados-abertos/atlas-digital-desastres-naturais-brasil-1991-2024.csv

# Diretório para armazenar dados do Atlas
ATLAS_DATA_DIR=./server/data/atlas

# Timeout do cache em minutos
ATLAS_CACHE_TIMEOUT_MINUTES=60

# Habilitar persistência em banco de dados
ATLAS_DB_ENABLED=true

# ============================================
# API KEYS (Optional - for external services)
ALLOW_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Development (uncomment for local dev):
# ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# ============================================
# EXTERNAL API KEYS
# ============================================
# Embrapa Climate API (https://www.embrapa.br/)
EMBRAPA_API_KEY=
EMBRAPA_API_URL=https://api.cnptia.embrapa.br
EMBRAPA_API_VERSION=climapi/v1

# NOAA Climate API (https://www.ncdc.noaa.gov/cdo-web/)
# Get API token from: https://www.ncdc.noaa.gov/cdo-web/token
NOAA_API_KEY=

# Unified Pricing NOAA tuning
# Weight of NOAA weather risk in combined_risk_score (0.0 to 1.0)
NOAA_RISK_BLEND_WEIGHT=0.15
# Maximum NOAA-driven premium uplift (0.0 to 0.5)
NOAA_PREMIUM_MAX_IMPACT=0.12

# Google Gemini AI (https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=

# ============================================
# HATHOR BLOCKCHAIN CONFIGURATION
# ============================================
# Hathor Network: testnet or mainnet
HATHOR_NETWORK=testnet
HATHOR_INTEGRATION_MODE=sandbox
HATHOR_PRODUCTION_STRICT=false

# Headless Wallet API (required for production mode)
HATHOR_HEADLESS_WALLET_URL=
HATHOR_HEADLESS_WALLET_API_KEY=
HATHOR_HTTP_TIMEOUT_SECONDS=8

# Hathor Wallet Configuration
# For production, integrate with hathor-wallet-lib or @hathor/wallet-lib
HATHOR_WALLET_ADDRESS=
HATHOR_WALLET_SEED=

# Token Configuration
HATHOR_CLIMATE_TOKEN_SYMBOL=CLMT
HATHOR_CLIMATE_TOKEN_NAME=Climate Index Token
HATHOR_CLIMATE_TOKEN_INITIAL_SUPPLY=1000000

# xAI Grok API (https://x.ai/)
GROK_API_KEY=

# OpenMeteo (free, no key required)
# OPENMETEO_API_KEY=

# ============================================
# CACHE CONFIGURATION
# ============================================
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379

# ============================================
# MONITORING & LOGGING
# ============================================
LOG_LEVEL=INFO
SENTRY_DSN=
PROMETHEUS_METRICS_ENABLED=true

# Grafana admin password
GRAFANA_ADMIN_PASSWORD=

# ============================================
# OPENTELEMETRY CONFIGURATION (NEW!)
# ============================================
# Enable OpenTelemetry tracing
OTEL_ENABLED=true

# OTLP Exporter endpoint (OpenTelemetry Collector)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Service identification
OTEL_SERVICE_NAME=climateai-backend
OTEL_SERVICE_VERSION=1.0.0

# Environment (production, staging, development)
ENVIRONMENT=production

# ============================================
# BLOCKCHAIN CONFIGURATION (Optional)
# ============================================
BLOCKCHAIN_ENABLED=false
BC_NODE_URL=
ADMIN_WALLET_ADDRESS=
MIN_BALANCE_THRESHOLD_ETHER=0.05

# ============================================
# FILE UPLOAD CONFIGURATION
# ============================================
MAX_FILE_SIZE=10485760
ALLOWED_FILE_EXTENSIONS=csv,json,xlsx,pdf

# ============================================
# DOMAIN CONFIGURATION (Production)
# ============================================
DOMAIN=yourdomain.com
