# ============================================
# ClimateAI Client Environment Variables
# ============================================
# INSTRUÇÕES:
# 1. Copie este arquivo para .env: cp .env.example .env
# 2. Preencha as variáveis necessárias
# 3. NUNCA commit o arquivo .env no Git!

# API Backend URL (obrigatório para produção)
VITE_API_BASE_URL=http://localhost:8000

# Supabase (opcional)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Mock Data (desenvolvimento/testes)
# Defina como 'true' para usar dados mock (sem backend)
VITE_USE_MOCK_DATA=false

# Feature Flags (opcional)
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_TOKENIZATION=true
