# ============================================
# ClimateAI Client Environment Variables
# ============================================
# INSTRUÇÕES:
# 1. Copie este arquivo para .env: cp .env.example .env
# 2. Preencha as variáveis necessárias
# 3. NUNCA commit o arquivo .env no Git!

# API Backend URL (obrigatório para produção)
VITE_API_BASE_URL=http://localhost:8000

# Supabase (opcional)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Mock Data (somente desenvolvimento)
# Nunca use true em build de produção — o Vite recusa o build.
VITE_USE_MOCK_DATA=false

# Feature flags (omitido = habilitado)
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_TOKENIZATION=true
VITE_ENABLE_ATLAS=true
VITE_ENABLE_ASSISTANT=true
