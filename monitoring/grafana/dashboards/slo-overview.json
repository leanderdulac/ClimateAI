{
  "dashboard": {
    "id": null,
    "uid": "slo-overview",
    "title": "SLO Overview - ClimateWise",
    "tags": ["slo", "platform", "climatewise"],
    "timezone": "America/Sao_Paulo",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "30s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"]
    },
    "templating": {
      "list": [
        {
          "name": "service",
          "type": "query",
          "datasource": "Prometheus",
          "query": "label_values(service_name)",
          "refresh": 2,
          "current": {
            "text": "climatewise-backend",
            "value": "climatewise-backend"
          }
        },
        {
          "name": "environment",
          "type": "custom",
          "datasource": "Prometheus",
          "query": "production,staging,development",
          "current": {
            "text": "production",
            "value": "production"
          }
        }
      ]
    },
    "panels": [
      {
        "id": 1,
        "gridPos": {"h": 4, "w": 24, "x": 0, "y": 0},
        "type": "stat",
        "title": "Service Health Status",
        "targets": [
          {
            "expr": "up{service_name=\"$service\", environment=\"$environment\"}",
            "legendFormat": "{{instance}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "red", "value": 0},
                {"color": "green", "value": 1}
              ]
            },
            "mappings": [
              {"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}}},
              {"type": "value", "options": {"1": {"text": "UP", "color": "green"}}}
            ]
          }
        }
      },
      {
        "id": 2,
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 4},
        "type": "gauge",
        "title": "Availability SLO (99.9%)",
        "targets": [
          {
            "expr": "sum(rate(http_requests_total{service_name=\"$service\", environment=\"$environment\", status_code!~\"5..\"}[5m])) / sum(rate(http_requests_total{service_name=\"$service\", environment=\"$environment\"}[5m])) * 100",
            "legendFormat": "Availability %",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "red", "value": 0},
                {"color": "yellow", "value": 99},
                {"color": "green", "value": 99.9}
              ]
            }
          }
        },
        "options": {
          "showThresholdLabels": true,
          "showThresholdMarkers": true
        }
      },
      {
        "id": 3,
        "gridPos": {"h": 8, "w": 8, "x": 8, "y": 4},
        "type": "gauge",
        "title": "Latency P99 SLO (<500ms)",
        "targets": [
          {
            "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{service_name=\"$service\", environment=\"$environment\"}[5m])) by (le)) * 1000",
            "legendFormat": "P99 Latency",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ms",
            "min": 0,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 250},
                {"color": "red", "value": 500}
              ]
            }
          }
        },
        "options": {
          "showThresholdLabels": true,
          "showThresholdMarkers": true
        }
      },
      {
        "id": 4,
        "gridPos": {"h": 8, "w": 8, "x": 16, "y": 4},
        "type": "gauge",
        "title": "Error Rate SLO (<0.1%)",
        "targets": [
          {
            "expr": "sum(rate(http_requests_total{service_name=\"$service\", environment=\"$environment\", status_code=~\"5..\"}[5m])) / sum(rate(http_requests_total{service_name=\"$service\", environment=\"$environment\"}[5m])) * 100",
            "legendFormat": "Error Rate %",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 5,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 0.05},
                {"color": "red", "value": 0.1}
              ]
            }
          }
        },
        "options": {
          "showThresholdLabels": true,
          "showThresholdMarkers": true
        }
      },
      {
        "id": 5,
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
        "type": "timeseries",
        "title": "Request Rate & Error Rate",
        "targets": [
          {
            "expr": "sum(rate(http_requests_total{service_name=\"$service\", environment=\"$environment\"}[1m])) * 60",
            "legendFormat": "Requests/min",
            "refId": "A",
            "axisLabel": "Requests/min"
          },
          {
            "expr": "sum(rate(http_requests_total{service_name=\"$service\", environment=\"$environment\", status_code=~\"5..\"}[1m])) * 60",
            "legendFormat": "Errors/min (5xx)",
            "refId": "B",
            "axisLabel": "Errors/min"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 10,
              "gradientMode": "hue"
            }
          }
        }
      },
      {
        "id": 6,
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
        "type": "timeseries",
        "title": "Latency Percentiles",
        "targets": [
          {
            "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{service_name=\"$service\", environment=\"$environment\"}[1m])) by (le)) * 1000",
            "legendFormat": "P50",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.90, sum(rate(http_request_duration_seconds_bucket{service_name=\"$service\", environment=\"$environment\"}[1m])) by (le)) * 1000",
            "legendFormat": "P90",
            "refId": "B"
          },
          {
            "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{service_name=\"$service\", environment=\"$environment\"}[1m])) by (le)) * 1000",
            "legendFormat": "P95",
            "refId": "C"
          },
          {
            "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{service_name=\"$service\", environment=\"$environment\"}[1m])) by (le)) * 1000",
            "legendFormat": "P99",
            "refId": "D"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ms",
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 10
            }
          }
        }
      },
      {
        "id": 7,
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20},
        "type": "timeseries",
        "title": "Circuit Breaker Status by External Service",
        "targets": [
          {
            "expr": "climatewise_circuit_breaker_state{service_name=\"$service\"}",
            "legendFormat": "{{external_service}} - {{state}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {"type": "value", "options": {"0": {"text": "CLOSED", "color": "green"}}},
              {"type": "value", "options": {"1": {"text": "OPEN", "color": "red"}}},
              {"type": "value", "options": {"2": {"text": "HALF_OPEN", "color": "yellow"}}}
            ],
            "custom": {
              "lineWidth": 2,
              "drawStyle": "line"
            }
          }
        }
      },
      {
        "id": 8,
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20},
        "type": "table",
        "title": "External API Health",
        "targets": [
          {
            "expr": "climatewise_external_api_latency_seconds{service_name=\"$service\"}",
            "format": "table",
            "instant": true,
            "refId": "A"
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {"Time": true, "__name__": true, "job": true, "instance": true},
              "renameByName": {
                "external_service": "Service",
                "Value": "Latency (s)",
                "environment": "Env"
              }
            }
          }
        ]
      },
      {
        "id": 9,
        "gridPos": {"h": 6, "w": 24, "x": 0, "y": 28},
        "type": "alertlist",
        "title": "Active Alerts",
        "options": {
          "showOptions": "current",
          "sortOrder": 1,
          "stateFilter": {"alerting": true, "pending": true, "noData": true, "error": true}
        }
      }
    ],
    "annotations": {
      "list": [
        {
          "name": "Deployments",
          "datasource": "Prometheus",
          "enable": true,
          "expr": "climatewise_deployments{service_name=\"$service\"}",
          "iconColor": "blue",
          "titleFormat": "Deployment"
        }
      ]
    },
    "links": [
      {
        "title": "Jaeger Traces",
        "url": "http://localhost:16686",
        "icon": "link",
        "targetBlank": true
      },
      {
        "title": "OTel Collector Health",
        "url": "http://localhost:13133/health",
        "icon": "info",
        "targetBlank": true
      }
    ]
  }
}
