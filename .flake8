[flake8]
max-line-length = 88
extend-ignore = E203, W503, E501
exclude =
    .git,
    __pycache__,
    .pytest_cache,
    venv,
    .venv,
    env,
    .env,
    build,
    dist,
    *.egg-info,
    .cache,
    .coverage,
    htmlcov,
    coverage_html,
    node_modules,
    client
max-complexity = 15
