# ClimateWise - Deploy Configuration
# This file contains deployment settings for different platforms

# ==========================================
# VERCEL CONFIGURATION
# ==========================================
# Frontend only deployment
# Backend should be deployed separately (DigitalOcean/Railway)

VERCEL_FRONTEND_URL=https://your-frontend.vercel.app
VERCEL_BACKEND_URL=https://your-backend.digitalocean.app

# ==========================================
# DIGITALOCEAN CONFIGURATION
# ==========================================
# Full stack deployment

DIGITALOCEAN_DROPLET_SIZE=s-1vcpu-1gb  # Basic plan
DIGITALOCEAN_REGION=sao-paulo-1       # São Paulo region
DIGITALOCEAN_IMAGE=ubuntu-22-04-x64

# Domain and SSL
DOMAIN=your-domain.com
EMAIL=admin@your-domain.com

# Database
DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# ==========================================
# PRODUCTION ENVIRONMENT VARIABLES
# ==========================================
# These will be set during deployment

SECRET_KEY=CHANGE_THIS_IN_PRODUCTION
DEBUG=False

# API Keys (optional)
OPENMETEO_API_KEY=
EMBRAPA_API_KEY=

# ==========================================
# MONITORING
# ==========================================
GRAFANA_ADMIN_PASSWORD=CHANGE_THIS_ADMIN_PASSWORD
PROMETHEUS_ENABLED=True

# ==========================================
# BACKUP SETTINGS
# ==========================================
BACKUP_RETENTION_DAYS=7
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM
